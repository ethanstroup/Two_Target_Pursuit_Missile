# Python environment and bytecode
.venv/
__pycache__/
*.pyc

# Per-machine editor and tool settings
.vscode/settings.json
.claude/settings.local.json

# Solver outputs: large, and regenerated by the scripts in each layer1 milestone folder
m2_out/
m3_out/
m4_out/
m5_out/

# Solver arrays outside those folders (stray copies); none are tracked
*.npy
*.npz

# Figures: the scripts write them. Figures committed before this rule stay tracked;
# add a new one on purpose with git add -f.
*.png
